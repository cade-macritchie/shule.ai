# --- shared ---
PUBLIC_BASE_URL=https://your-app.example.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# live turns need speed; offline work needs depth
CLAUDE_MODEL_LIVE=claude-haiku-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5

# --- scheduling / meetings ---
INTERVIEW_MEDIUM=room            # room = our browser interview room (default); zoom = Recall bot on a Zoom link
STT_PROVIDER=deepgram            # deepgram | openai  (room speech-to-text, per utterance)
DEEPGRAM_API_KEY=
STT_VOCAB=Slate, Jenzabar, Caspio, Raiser's Edge
CAL_BOOKING_URL=https://cal.com/your-team/process-interview
CAL_WEBHOOK_SECRET=
# Zoom medium only:
RECALL_REGION=us-west-2
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
BOT_NAME=ProcessScope Interviewer

# --- email ---
RESEND_API_KEY=
EMAIL_FROM=ProcessScope <interviews@your-domain.com>
STAFF_EMAIL=

# --- voice / video ---
TTS_PROVIDER=elevenlabs          # elevenlabs | openai | none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
NEXT_PUBLIC_TTS_PROXY=/api/tts    # agent page fetches speech through the web app

# --- worker ---
WORKER_KINDS=                     # blank = all; e.g. render_video,storyboard on a GPU box
RETENTION_DAYS=30
WHISPER_MODEL=small.en
